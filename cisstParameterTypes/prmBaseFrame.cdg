// -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*-
// ex: set filetype=cpp softtabstop=4 shiftwidth=4 tabstop=4 cindent expandtab:

inline-header {
#include <Eigen/Geometry>
#include <cisstParameterTypes/prmStateCartesian.h>

// Always include last
#include <cisstParameterTypes/prmExport.h>

// Following needed on Windows
#ifdef interface
#undef interface
#endif
}

class {
    name prmBaseFrame;

    attribute CISST_EXPORT;

    base-class {
        type mtsGenericObject;
        is-data true;
    }

    member {
        name reference_frame;
        type std::string;
        default "";
        description Name of reference frame for a fixed base frame;
    }

    member {
        name transform;
        type Eigen::Isometry3d;
        default Eigen::Isometry3d::Identity();
        description Homogeneous transform from local frame to base frame;
    }

    member {
        name component;
        type std::string;
        default "";
        description Component name for a dynamic base frame provider;
    }

    member {
        name interface;
        type std::string;
        default "";
        description Interface name for a dynamic base frame provider;
    }

    inline-header {
    private:
        CMN_DECLARE_SERVICES(CMN_DYNAMIC_CREATION, CMN_LOG_ALLOW_DEFAULT);

    public:
        inline bool ValidDefinition(void) const {
            return ((Fixed() && !Dynamic() && interface().empty())
                    || (!Fixed() && Dynamic()
                        && (transform().isApprox(Eigen::Isometry3d::Identity(), 0.0))
                        && !interface().empty()));
        }

        inline bool Fixed(void) const {
            return !reference_frame().empty();
        }

        inline bool Dynamic(void) const {
            return !component().empty();
        }

        inline void ApplyTo(const prmStateCartesian & local,
                            prmStateCartesian & withBase) const {
            withBase = local;
            if (!ValidDefinition()) {
                cmnThrow("prmBaseFrame::ApplyTo: invalid base frame");
            }
            if (!Fixed()) {
                cmnThrow("prmBaseFrame::ApplyTo: only fixed base frames can be applied directly");
            }

            Eigen::Isometry3d fixedTransform = transform();
            const Eigen::Matrix3d& rotation = fixedTransform.rotation();
            withBase.ReferenceFrame() = reference_frame();

            if (local.PositionIsValid()) {
                withBase.Position() = fixedTransform * local.Position();
                withBase.PositionIsValid() = true;
            }

            if (local.VelocityIsValid()) {
                withBase.Velocity().head<3>() = rotation * local.Velocity().head<3>();
                withBase.Velocity().tail<3>() = rotation * local.Velocity().tail<3>();
                withBase.VelocityIsValid() = true;
            }

            if (local.ForceIsValid()) {
                withBase.Force().head<3>() = rotation * local.Force().head<3>();
                withBase.Force().tail<3>() = rotation * local.Force().tail<3>();
                withBase.ForceIsValid() = true;
            }
        }
    }
}

inline-header {
CMN_DECLARE_SERVICES_INSTANTIATION(prmBaseFrame);
}
