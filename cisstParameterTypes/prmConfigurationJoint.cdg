// -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*-
// ex: set filetype=cpp softtabstop=4 shiftwidth=4 tabstop=4 cindent expandtab:

inline-header {
#include <cisstCommon/cmnJointType.h>
#include <cisstMultiTask/mtsGenericObject.h>
#include <cisstParameterTypes/prmJointType.h>

#include <Eigen/Dense>

// Always include last
#include <cisstParameterTypes/prmExport.h>
}

class {
    name prmConfigurationJoint;

    attribute CISST_EXPORT;

    base-class {
        type mtsGenericObject;
        is-data true;
    }

    member {
        name Name;
        type std::vector<std::string>;
    }

    member {
        name Type;
        type std::vector<cmnJointType>;
    }

    member {
        name PositionMin;
        type Eigen::ArrayXd;
    }
    member {
        name PositionMax;
        type Eigen::ArrayXd;
    }

    member {
        name VelocityMin;
        type Eigen::ArrayXd;
    }
    member {
        name VelocityMax;
        type Eigen::ArrayXd;
    }

    member {
        name AccelerationMin;
        type Eigen::ArrayXd;
    }
    member {
        name AccelerationMax;
        type Eigen::ArrayXd;
    }

    member {
        name EffortMin;
        type Eigen::ArrayXd;
    }
    member {
        name EffortMax;
        type Eigen::ArrayXd;
    }

    inline-header {
    public:
        // Return concatenation of this with other
        inline prmConfigurationJoint append(const prmConfigurationJoint& other) const {
            prmConfigurationJoint combined = *this; // make copy

            combined.Name().insert(combined.Name().end(), other.Name().begin(), other.Name().end());
            combined.Type().insert(combined.Type().end(), other.Type().begin(), other.Type().end());

            combined.PositionMin() = Eigen::VectorXd(PositionMin().size() + other.PositionMin().size());
            combined.PositionMin() << PositionMin(), other.PositionMin();

            combined.PositionMax() = Eigen::VectorXd(PositionMax().size() + other.PositionMax().size());
            combined.PositionMax() << PositionMax(), other.PositionMax();

            combined.VelocityMin() = Eigen::VectorXd(VelocityMin().size() + other.VelocityMin().size());
            combined.VelocityMin() << VelocityMin(), other.VelocityMin();

            combined.VelocityMax() = Eigen::VectorXd(VelocityMax().size() + other.VelocityMax().size());
            combined.VelocityMax() << VelocityMax(), other.VelocityMax();

            combined.AccelerationMin() = Eigen::VectorXd(AccelerationMin().size() + other.AccelerationMin().size());
            combined.AccelerationMin() << AccelerationMin(), other.AccelerationMin();

            combined.AccelerationMax() = Eigen::VectorXd(AccelerationMax().size() + other.AccelerationMax().size());
            combined.AccelerationMax() << AccelerationMax(), other.AccelerationMax();

            combined.EffortMin() = Eigen::VectorXd(EffortMin().size() + other.EffortMin().size());
            combined.EffortMin() << EffortMin(), other.EffortMin();

            combined.EffortMax() = Eigen::VectorXd(EffortMax().size() + other.EffortMax().size());
            combined.EffortMax() << EffortMax(), other.EffortMax();

            return combined;
        }
    private:
        CMN_DECLARE_SERVICES(CMN_DYNAMIC_CREATION, CMN_LOG_ALLOW_DEFAULT);
    }
}


inline-header {
CMN_DECLARE_SERVICES_INSTANTIATION(prmConfigurationJoint);
}
