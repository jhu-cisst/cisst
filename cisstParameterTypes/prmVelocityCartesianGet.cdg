// -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*-
// ex: set filetype=cpp softtabstop=4 shiftwidth=4 tabstop=4 cindent expandtab:

inline-header {
#include <Eigen/Dense>

// Always include last
#include <cisstParameterTypes/prmExport.h>
}

class {
    name prmVelocityCartesianGet;

    attribute CISST_EXPORT;

    base-class {
        type mtsGenericObject;
        is-data true;
    }

    member {
        name Velocity;
        type Eigen::Vector<double, 6>;
        default Eigen::Vector<double, 6>::Zero();
        description 6D velocity vector (linear xyz, angular xyz);
    }

    member {
        name MovingFrame;
        type std::string;
        default "";
        description Name of moving frame;
    }

    member {
        name ReferenceFrame;
        type std::string;
        default "";
        description Name reference frame;
    }


    // For any type derived from cmnGenericObject we need to add some code in the header file
    // Note that if you decided to use the 'proxy' approach for cisstMultiTask, you would have to
    // replace this code by something like:
    //     typedef mtsGenericObjectProxy<MyClass> mtsMyClassProxy;
    //     CMN_DECLARE_SERVICES_INSTANTIATION(mtsMyClassProxy)
    inline-header {
    private:
        CMN_DECLARE_SERVICES(CMN_DYNAMIC_CREATION, CMN_LOG_ALLOW_DEFAULT);

    public:
        inline Eigen::Ref<Eigen::Vector3d> VelocityLinear(void) {
            return mVelocity.head<3>();
        }

        inline Eigen::Ref<const Eigen::Vector3d> VelocityLinear(void) const {
            return mVelocity.head<3>();
        }

        inline void SetVelocityLinear(const Eigen::Vector3d& v) {
            VelocityLinear() = v;
        }

        inline Eigen::Ref<Eigen::Vector3d> VelocityAngular(void) {
            return mVelocity.tail<3>();
        }

        inline Eigen::Ref<const Eigen::Vector3d> VelocityAngular(void) const {
            return mVelocity.tail<3>();
        }

        inline void SetVelocityAngular(const Eigen::Vector3d& v) {
            VelocityAngular() = v;
        }
    }
}

// inline code added outside the class's scope
inline-header {
CMN_DECLARE_SERVICES_INSTANTIATION(prmVelocityCartesianGet);
}
